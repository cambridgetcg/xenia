  "data_ownership": {
    "core": "No process, database or credential ownership.",
    "host": "Chooses paths, authorizes exact use and retains recovery context.",
    "backend": "Stores the selected plaintext journal and mode-0600 bound-session credentials; tokens are never returned through this adapter.",
    "retained_on_exit": ["journal", "tasks", "reports", "source evidence"],
    "removed_on_confirmed_end": ["only the bound session's credential file"]
  },
  "limits": [
    "Only coordination-mode task creation is exposed; no file editing or work execution is authorized by a lease.",
    "Presence, handoff, checkpoints, native resume/recovery and provider migration remain native capabilities, not implemented by this initial adapter.",
    "Observation is not acknowledgement; acknowledgement is an explicit claim of processing, not agreement.",
    "Unexpected transport/results latch an unknown outcome and disable ordinary work. No automatic mutation replay or forced completion.",
    "Existing backend stores may migrate when the explicitly chosen backend starts. Review and back them up first; the demo refuses an existing state directory.",
    "The byte hash is a local integrity check, not publisher authentication or an OS sandbox. Use trusted reviewed local code.",
    "Static metadata is not activation, adoption, identity proof, authority, consent or conformance."
  ],
  "upgrade": "Use the inert upgrade preview, review code/effects/provider compatibility, retire the current instance, then explicitly construct a replacement. No automatic migration or rollback.",
  "retirement": "Admission closes first. Known owned leases are released without completing tasks; then the session ends and its process closes. Failure/uncertainty retains evidence and reports cleanup_pending for explicit native recovery."
