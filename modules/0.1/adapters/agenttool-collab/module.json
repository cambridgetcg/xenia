{
  "schema": "urn:xenia:development:module-card:0.1",
  "status": "source-only-development",
  "descriptor": {
    "id": "agenttool-collab",
    "version": "0.1.0-dev",
    "contract_version": "xenia.module/0.1-dev",
    "state_schema_version": 1,
    "operations": ["status", "next", "acknowledge", "report", "createTask", "getTask", "claimTask", "releaseTask"],
    "effects": ["local-process-start", "selected-local-journal-initialize-or-migrate", "bound-session-credential-create-and-end", "explicit-coordination-writes", "local-git-metadata-inspection"]
  },
  "input_schemas": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": []
    },
    "acknowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epoch_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "epoch_id",
            "sequence",
            "hash"
          ]
        },
        "expected_cursor_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "anchor",
        "expected_cursor_version"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "inference",
            "proposal"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "limits": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "idempotency_key",
        "kind",
        "body"
      ]
    },
    "createTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "idempotency_key",
        "title"
      ]
    },
    "getTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "task_id"
      ]
    },
    "claimTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "task_id",
        "idempotency_key",
        "expected_version"
      ]
    },
    "releaseTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "task_id",
        "idempotency_key",
        "expected_version"
      ]
    }
  },
  "purpose": "One optional local coordination capability. The Xenia core needs none of its runtime dependencies.",
